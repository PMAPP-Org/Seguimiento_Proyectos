# === VisitaCampo — .gitignore raíz del monorepo ===
# Cubre app/ (Flutter), server/ (Django), infra/ (Docker) y artefactos comunes.
# Decisión (Paso 0): los archivos generados por build_runner (*.g.dart, *.freezed.dart, etc.)
# NO se versionan por defecto — se regeneran con `flutter pub run build_runner build`.
# Si algún paso posterior necesita versionar un .g.dart puntual, se debe excepcionar
# explícitamente aquí con `!ruta/al/archivo.g.dart` y documentar el motivo.

# --- Flutter / Dart (app/) ---
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/*.iml
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
app/android/local.properties
app/android/**/gradle-wrapper.jar
app/android/.gradle/
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec

# --- Python / Django (server/) ---
server/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
server/staticfiles/
server/media/
# Raíz del adaptador `LocalFsBlobStore` (ADR-007, Paso 17): adjuntos de
# desarrollo depositados en el filesystem. Nunca se versionan.
server/.blobstore/
*.sqlite3
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# --- Docker / infra ---
infra/**/volumes/
infra/**/data/
*.log

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Artefactos de calidad / DAST (CI y local) ---
.coverage
coverage*.xml
app/coverage/
.schemathesis/
reports/
zap/

# Simulacro de backup en CI (.github/workflows/backup.yml)
.ci-backups/
age-identity.txt
wrong-identity.txt
# CI del monitoreo (.github/workflows/monitoring.yml)
.ci-ca-bundle.crt
rendered/
