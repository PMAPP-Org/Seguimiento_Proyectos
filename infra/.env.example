# VisitaCampo — plantilla de variables de entorno (patrón C-16, docs/08 §7.1,
# heredado de docs/05 §6.2).
#
# Uso:
#   1. Copia este archivo a `infra/.env` (NUNCA se versiona — ver .gitignore).
#   2. Rellena cada valor real. Los marcados como "CAMBIAR EN PRODUCCION" son
#      placeholders de desarrollo que NO deben usarse fuera de tu máquina.
#   3. Ejecuta `bash infra/scripts/check_envvars.sh` para confirmar que tu
#      `.env` define todas las variables que este archivo documenta.
#   4. `docker compose` se ejecuta desde `infra/` (o con
#      `--project-directory infra`) para que recoja `infra/.env`
#      automáticamente, incluida la variable especial COMPOSE_FILE de abajo.
#
# Cada variable debe estar documentada aquí — no se admiten variables
# "fantasma" usadas por el código pero ausentes de esta plantilla (docs/05 §6.2).

# --- Selección de entorno (Docker Compose) ---------------------------------
# Encadena el compose base con el/los override(s) del entorno, en vez de pasar
# `-f` manualmente (docs/08 ADR-010 / C-16). Para desarrollo:
COMPOSE_FILE=docker-compose.yml:docker-compose.override.dev.yml
# El separador de rutas es `:` en Linux/macOS y `;` en Windows nativo; con
# Git Bash / WSL usa `:`. En producción (self-hosted/managed) este valor
# cambiará a los overrides correspondientes cuando se creen en pasos
# posteriores de infraestructura (ver infra/README.md).

# --- Postgres (servicio `db`) -----------------------------------------------
POSTGRES_DB=visitacampo
POSTGRES_USER=visitacampo
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_postgres
# Host/puerto tal como los verá el backend Django (Paso 4): dentro de la red
# de Docker Compose el servicio se resuelve por su nombre, no por localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django (servicios `api` / `worker`, esqueleto en Paso 4) --------------
# Clave de firma de sesiones/tokens internos de Django. Generar con
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` o equivalente.
DJANGO_SECRET_KEY=CAMBIAR_EN_PRODUCCION_django_secret_key
# "true" solo en desarrollo local. En producción SIEMPRE "false" (ADR-010 / RD-15).
DJANGO_DEBUG=true
# Módulo de settings de Django. En producción/self-hosted debe ser
# "config.settings.prod" (Tarea 3 de
# plans/visitacampo-despliegue-demo-implementacion.md). NOTA:
# `infra/docker-compose.override.dev.yml` no sobreescribe esta variable hoy
# — un `docker compose up` de desarrollo también arranca con
# "config.settings.prod" salvo que se edite `infra/.env` localmente a
# "config.settings.dev".
DJANGO_SETTINGS_MODULE=config.settings.prod
# Lista de hosts separados por coma que Django acepta en la cabecera Host
# (config/settings/prod.py). En desarrollo no se usa (dev.py fija "*"), pero
# debe existir en .env para que check_envvars.sh no falle. Ejemplo real:
# DJANGO_ALLOWED_HOSTS=visitas.tudominio.com
DJANGO_ALLOWED_HOSTS=localhost

# --- Autenticación JWT (ADR-008, implementada en el Paso 7) ----------------
# Clave de firma Ed25519 para los access tokens de 15 min. El Paso 7 fija el
# formato: **PEM PKCS#8 sin cifrar**, o su base64 (una sola línea, que es lo
# que cabe aquí). Generar una nueva por despliegue con:
#
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import \
#     Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; \
#     import base64; print(base64.b64encode(Ed25519PrivateKey.generate().private_bytes( \
#       serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, \
#       serialization.NoEncryption())).decode())"
#
# NO reutilizar este valor de ejemplo: quien tenga la clave puede firmar un
# token válido para cualquier usuario y organización.
JWT_SIGNING_KEY=CAMBIAR_EN_PRODUCCION_jwt_ed25519_signing_key
# Alternativa **recomendada** en producción (ADR-008: "montada como secreto de
# archivo"): ruta a un PEM montado como secreto. Si está definida, gana sobre
# JWT_SIGNING_KEY — un archivo no aparece en `ps`, ni en `docker inspect`, ni
# se hereda al entorno de los subprocesos. Vacía en desarrollo.
JWT_SIGNING_KEY_FILE=

# --- Almacenamiento de adjuntos S3-compatible (ADR-007, Cloudflare R2) -----
# Adaptador de `BlobStore` en uso (Paso 17, ADR-007 punto 1):
#   s3      -> Cloudflare R2 en produccion, MinIO en el override de desarrollo.
#   localfs -> filesystem local, para tests y desarrollo sin red.
# Si se deja vacia, el backend Django la deriva: `s3` cuando hay
# STORAGE_S3_BUCKET_NAME configurado, `localfs` cuando no lo hay.
STORAGE_BACKEND=s3
# En desarrollo (override.dev.yml) estas mismas credenciales las usa el
# contenedor `minio` como MINIO_ROOT_USER/MINIO_ROOT_PASSWORD, y el
# contenedor `createbuckets` crea STORAGE_S3_BUCKET_NAME automáticamente.
# En producción, sustituir por credenciales reales de un bucket R2 (usar un
# token con permisos mínimos, nunca la API key global de la cuenta).
STORAGE_S3_ENDPOINT_URL=http://minio:9000
STORAGE_S3_ACCESS_KEY_ID=CAMBIAR_EN_PRODUCCION_s3_access_key
STORAGE_S3_SECRET_ACCESS_KEY=CAMBIAR_EN_PRODUCCION_s3_secret_key
STORAGE_S3_BUCKET_NAME=visitacampo-dev
# R2 usa "auto" como región; MinIO la ignora pero Django/boto3 la exige.
STORAGE_S3_REGION=auto
# MinIO (y R2 en la práctica) requieren direccionamiento "path-style"
# (http://host/bucket/key) en vez de virtual-hosted-style.
STORAGE_S3_USE_PATH_STYLE=true

# --- Correo saliente (MailHog en dev; SMTP real en producción) -------------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# --- Caddy (TLS / reverse proxy, ADR-010, RD-15) ----------------------------
# "localhost" = certificado interno autofirmado de Caddy (sin red, sin ACME).
# En producción: el dominio DNS real, p. ej. visitas.tuempresa.com — Caddy
# emitirá y renovará el certificado Let's Encrypt automáticamente.
CADDY_DOMAIN=localhost
# Correo de contacto exigido por Let's Encrypt para avisos de expiración/abuso.
CADDY_ACME_EMAIL=admin@example.com
# Orígenes que pueden abrir /admin/ (CIDR separados por espacio). Fuera de
# ellos Caddy responde 404. Por defecto solo 127.0.0.1: accede por túnel SSH
# (ssh -L 8443:localhost:443 deploy@servidor) o pon aquí la IP de la oficina/VPN.
CADDY_ADMIN_ALLOWED_IPS=127.0.0.1/32

# --- Backups (servicio `backup`, infra/backup/README.md, ISO 27001 A.8.13) ---
# Llave PÚBLICA age (age1…). La privada NO va aquí ni en el servidor: se guarda
# fuera (gestor de secretos + copia offline) y solo se usa para restaurar.
# Vacía = backups desactivados (desarrollo).
BACKUP_AGE_RECIPIENT=
# Destino rclone: remoto `backup` (configurado con BACKUP_S3_*) + bucket.
BACKUP_REMOTE=backup:visitacampo-backups
# Bucket S3/R2 de backups, DISTINTO del de adjuntos y con credenciales propias
# limitadas a ese bucket. Proveedor rclone: Cloudflare | Minio | Other.
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT_URL=https://CUENTA.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=CAMBIAR_EN_PRODUCCION_backup_access_key
BACKUP_S3_SECRET_ACCESS_KEY=CAMBIAR_EN_PRODUCCION_backup_secret_key
# Origen de adjuntos: `blobs:<bucket>` con STORAGE_BACKEND=s3, `/blobs` con
# localfs, vacío para no copiarlos.
BACKUP_BLOBS_SOURCE=blobs:visitacampo-dev
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
