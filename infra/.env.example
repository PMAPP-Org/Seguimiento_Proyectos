# VisitaCampo — plantilla de variables de entorno (patrón C-16, docs/08 §7.1,
# heredado de docs/05 §6.2).
#
# Uso:
#   1. Copia este archivo a `infra/.env` (NUNCA se versiona — ver .gitignore).
#   2. Rellena cada valor real. Los marcados como "CAMBIAR EN PRODUCCION" son
#      placeholders de desarrollo que NO deben usarse fuera de tu máquina.
#   3. Ejecuta `bash infra/scripts/check_envvars.sh` para confirmar que tu
#      `.env` define todas las variables que este archivo documenta.
#   4. `docker compose` se ejecuta desde `infra/` (o con
#      `--project-directory infra`) para que recoja `infra/.env`
#      automáticamente, incluida la variable especial COMPOSE_FILE de abajo.
#
# Cada variable debe estar documentada aquí — no se admiten variables
# "fantasma" usadas por el código pero ausentes de esta plantilla (docs/05 §6.2).

# --- Selección de entorno (Docker Compose) ---------------------------------
# Encadena el compose base con el/los override(s) del entorno, en vez de pasar
# `-f` manualmente (docs/08 ADR-010 / C-16). Para desarrollo:
COMPOSE_FILE=docker-compose.yml:docker-compose.override.dev.yml
# El separador de rutas es `:` en Linux/macOS y `;` en Windows nativo; con
# Git Bash / WSL usa `:`. En producción (self-hosted/managed) este valor
# cambiará a los overrides correspondientes cuando se creen en pasos
# posteriores de infraestructura (ver infra/README.md).

# --- Postgres (servicio `db`) -----------------------------------------------
POSTGRES_DB=visitacampo
POSTGRES_USER=visitacampo
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_postgres
# Host/puerto tal como los verá el backend Django (Paso 4): dentro de la red
# de Docker Compose el servicio se resuelve por su nombre, no por localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django (servicios `api` / `worker`, esqueleto en Paso 4) --------------
# Clave de firma de sesiones/tokens internos de Django. Generar con
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` o equivalente.
DJANGO_SECRET_KEY=CAMBIAR_EN_PRODUCCION_django_secret_key
# "true" solo en desarrollo local. En producción SIEMPRE "false" (ADR-010 / RD-15).
DJANGO_DEBUG=true

# --- Autenticación JWT (ADR-008, se implementa a partir del Paso 4/6) ------
# Clave de firma Ed25519 para access tokens de 15 min. Placeholder aquí; el
# formato exacto (PEM, base64, ruta a archivo montado como secreto) se define
# junto con el código de autenticación. NO reutilizar este valor de ejemplo.
JWT_SIGNING_KEY=CAMBIAR_EN_PRODUCCION_jwt_ed25519_signing_key

# --- Almacenamiento de adjuntos S3-compatible (ADR-007, Cloudflare R2) -----
# En desarrollo (override.dev.yml) estas mismas credenciales las usa el
# contenedor `minio` como MINIO_ROOT_USER/MINIO_ROOT_PASSWORD, y el
# contenedor `createbuckets` crea STORAGE_S3_BUCKET_NAME automáticamente.
# En producción, sustituir por credenciales reales de un bucket R2 (usar un
# token con permisos mínimos, nunca la API key global de la cuenta).
STORAGE_S3_ENDPOINT_URL=http://minio:9000
STORAGE_S3_ACCESS_KEY_ID=CAMBIAR_EN_PRODUCCION_s3_access_key
STORAGE_S3_SECRET_ACCESS_KEY=CAMBIAR_EN_PRODUCCION_s3_secret_key
STORAGE_S3_BUCKET_NAME=visitacampo-dev
# R2 usa "auto" como región; MinIO la ignora pero Django/boto3 la exige.
STORAGE_S3_REGION=auto
# MinIO (y R2 en la práctica) requieren direccionamiento "path-style"
# (http://host/bucket/key) en vez de virtual-hosted-style.
STORAGE_S3_USE_PATH_STYLE=true

# --- Correo saliente (MailHog en dev; SMTP real en producción) -------------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# --- Caddy (TLS / reverse proxy, ADR-010, RD-15) ----------------------------
# "localhost" = certificado interno autofirmado de Caddy (sin red, sin ACME).
# En producción: el dominio DNS real, p. ej. visitas.tuempresa.com — Caddy
# emitirá y renovará el certificado Let's Encrypt automáticamente.
CADDY_DOMAIN=localhost
# Correo de contacto exigido por Let's Encrypt para avisos de expiración/abuso.
CADDY_ACME_EMAIL=admin@example.com
