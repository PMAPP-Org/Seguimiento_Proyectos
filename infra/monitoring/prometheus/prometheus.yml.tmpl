# Prometheus de VisitaCampo (ADR-014). Plantilla: al arrancar, el contenedor
# sustituye __CADDY_DOMAIN__ por el dominio real (docker-compose.monitoring.yml).
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    deployment: visitacampo

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  # Servidor: CPU, memoria, disco, carga, y la métrica del backup
  # (textfile collector sobre el volumen backup_metrics).
  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: postgres
    static_configs:
      - targets: ["postgres-exporter:9187"]

  - job_name: blackbox
    static_configs:
      - targets: ["blackbox:9115"]

  # Sondas de la API por el mismo camino que un cliente real: dominio →
  # Caddy (TLS, cabeceras) → API. `healthz` = el proceso responde;
  # `readyz` = además llega a PostgreSQL y al almacenamiento de adjuntos.
  - job_name: api-probe
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets: ["https://__CADDY_DOMAIN__/v1/healthz"]
        labels:
          endpoint: healthz
      - targets: ["https://__CADDY_DOMAIN__/v1/readyz"]
        labels:
          endpoint: readyz
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
